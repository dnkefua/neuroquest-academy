{
  "name": "neuroquest-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloud-run": "next build",
    "build:firebase": "cross-env NEXT_OUTPUT=static next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "export": "next build",
    "deploy:firebase": "npm run build:firebase && firebase deploy --only hosting",
    "deploy:cloud-run": "npm run build:cloud-run && gcloud builds submit --config cloudbuild.yaml .",
    "build:mobile": "npm run build:firebase",
    "mobile:assets": "node tools/generate-mobile-assets.mjs && capacitor-assets generate --ios --android",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "npm run build:mobile && cap sync android",
    "mobile:ios": "npm run build:mobile && cap sync ios",
    "mobile:android:release": "powershell -ExecutionPolicy Bypass -File tools/build-android-release.ps1",
    "mobile:play:internal": "node tools/upload-play-internal.mjs",
    "mobile:play:share": "node tools/upload-play-internal-sharing.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@google-cloud/aiplatform": "^6.5.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.36",
    "@langchain/langgraph": "^1.2.6",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@types/gsap": "^1.20.2",
    "@types/howler": "^2.2.12",
    "@types/three": "^0.183.1",
    "canvas-confetti": "^1.9.3",
    "firebase": "^10.12.2",
    "framer-motion": "^11.3.8",
    "google-auth-library": "^10.6.2",
    "gsap": "^3.14.2",
    "howler": "^2.2.4",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.7",
    "three": "^0.183.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "jsdom": "^29.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
